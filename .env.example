# Copy this file to .env and fill it in. Never commit .env.
# The application reads .env from its working directory (mvn spring-boot:run, the IDE), and
# docker compose passes it to the API container. Commented-out lines show the defaults.

# ---- Database (PostgreSQL) ----
# docker compose ignores these three and always uses its own database.
DB_URL=jdbc:postgresql://localhost:5432/khronos
DB_USERNAME=khronos
DB_PASSWORD=khronos

# ---- Tokens ----
# Signing secret, at least 32 bytes. Generate one with: openssl rand -base64 48
# The application refuses to start without it. Changing it signs everyone out.
JWT_SECRET=
# Access token lifetime as an ISO-8601 duration; clients get a new one with their refresh token
#JWT_TTL=PT1H
# A signed-in device unused for this long has to sign in again; each use starts the count again
#SESSION_IDLE_TTL=P90D
# Signed-in devices per user; signing in on one more ends the one that would end soonest
#SESSION_MAX_PER_USER=20
# A replaced refresh token sent again within this time is taken as a retry, not a stolen copy
#SESSION_REUSE_GRACE=PT1M

# ---- First platform admin ----
# Created on startup only when no user has this username yet; an existing account is never changed.
# Leave all three empty to skip. The password needs at least 16 characters and at most 72 bytes.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=

# ---- Login attempts ----
# Failed logins allowed per username and client IP within the window before login answers 429
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW=PT15M
# Failed logins allowed per client IP within the same window, whatever the usernames, before every
# login from that IP answers 429
#LOGIN_MAX_ATTEMPTS_PER_IP=50
# Failed logins allowed per username within LOGIN_USER_WINDOW, whatever the IPs, before login answers 429
# for it, except from an IP it signed in from successfully in the last 30 days
#LOGIN_MAX_ATTEMPTS_PER_USER=10
#LOGIN_USER_WINDOW=PT1H
# Takes the client IP from X-Forwarded-For when the connection comes from a private address (a reverse
# proxy). On by default; none turns it off. A proxy on a public address goes in the regex below
#SERVER_FORWARD_HEADERS_STRATEGY=native
#SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

# ---- In-app notifications ----
# Notices older than this are deleted every night, as an ISO-8601 duration
#NOTIFICATIONS_RETENTION=P90D

# ---- Push notifications (Web Push) ----
# Optional: leave the keys empty and workers only see the in-app list. Generate a pair once with
#   npx web-push generate-vapid-keys
# and keep it: changing it stops every device's notifications until each worker turns them on again.
# The subject is a contact for the push services, mailto: or https:.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# How long a push service keeps a message for a phone that is off, as an ISO-8601 duration
#PUSH_TTL=P1D
#PUSH_CONNECT_TIMEOUT=PT5S
#PUSH_READ_TIMEOUT=PT10S
# Push service hosts a device's endpoint may point at; *.host also takes its subdomains
#PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com

# ---- Web ----
# Comma-separated browser origins allowed to call the API, for example http://localhost:5173.
# Empty means no cross-origin access.
CORS_ALLOWED_ORIGINS=
# Most items accepted in one POST of shifts, events or assignments
#BATCH_MAX_SIZE=200

# ---- Time tracking ----
# ISO-8601 durations. A shift whose first clock-in is later than this after it starts counts as late
#LATE_THRESHOLD=PT10M
# A clock-in up to this long before a shift starts (or during it) is matched to that shift
#SHIFT_MATCH_WINDOW=PT3H
# An entry still open after this long is flagged as stale (a forgotten clock-out)
#STALE_ENTRY_AFTER=PT16H

# ---- Cash closings ----
# Largest difference between counted and expected cash, in euros either way, a day can be closed with
# without giving a reason
#CASH_DIFFERENCE_THRESHOLD=5.00

# ---- docker compose only ----
#POSTGRES_PASSWORD=khronos
#API_PORT=8080
#DB_PORT=5432
