# Copy this file to .env and fill it in. Never commit .env.
# The application reads .env from its working directory (mvn spring-boot:run, the IDE), and
# docker compose passes it to the API container. Commented-out lines show the defaults.

# ---- Database (PostgreSQL) ----
# docker compose ignores these three and always uses its own database.
DB_URL=jdbc:postgresql://localhost:5432/khronos
DB_USERNAME=khronos
DB_PASSWORD=khronos

# ---- Tokens ----
# Signing secret, at least 32 bytes. Generate one with: openssl rand -base64 48
# The application refuses to start without it. Changing it signs everyone out.
JWT_SECRET=
# Token lifetime as an ISO-8601 duration
#JWT_TTL=PT1H

# ---- First platform admin ----
# Created on startup only when no user has this username yet; an existing account is never changed.
# Leave all three empty to skip. The password needs at least 8 characters and at most 72 bytes.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=

# ---- Login attempts ----
# Failed logins allowed per username and client IP within the window before login answers 429
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW=PT15M
# Failed logins allowed per client IP within the same window, whatever the usernames, before every
# login from that IP answers 429
#LOGIN_MAX_ATTEMPTS_PER_IP=50
# Behind a reverse proxy that sets X-Forwarded-For, set this to native so the limit sees the real client IP
#SERVER_FORWARD_HEADERS_STRATEGY=native

# ---- Email (Resend) ----
# Required. Sends fail (and are recorded in email_logs) if the key is wrong.
RESEND_API_KEY=
#RESEND_FROM=Khronos <onboarding@resend.dev>
#RESEND_BASE_URL=https://api.resend.com
#RESEND_CONNECT_TIMEOUT=PT5S
#RESEND_READ_TIMEOUT=PT10S

# ---- Web ----
# Comma-separated browser origins allowed to call the API, for example http://localhost:5173.
# Empty means no cross-origin access.
CORS_ALLOWED_ORIGINS=
# Most items accepted in one POST of shifts, events or assignments
#BATCH_MAX_SIZE=200

# ---- Time tracking ----
# ISO-8601 durations. A shift whose first clock-in is later than this after it starts counts as late
#LATE_THRESHOLD=PT10M
# A clock-in up to this long before a shift starts (or during it) is matched to that shift
#SHIFT_MATCH_WINDOW=PT3H
# An entry still open after this long is flagged as stale (a forgotten clock-out)
#STALE_ENTRY_AFTER=PT16H

# ---- Cash closings ----
# Largest difference between counted and expected cash, in euros either way, a day can be closed with
# without giving a reason
#CASH_DIFFERENCE_THRESHOLD=5.00

# ---- docker compose only ----
#POSTGRES_PASSWORD=khronos
#API_PORT=8080
#DB_PORT=5432
